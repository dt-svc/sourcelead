<project name="deploy-vms" basedir="../" default="deploy-vms">
   <condition property="unix">
		<os family="unix" />
	</condition>

	<condition property="windows">
		<os family="windows" />
	</condition>

	<condition property="root.dir" value="c:">
		<isset property="windows" />
	</condition>
	<condition property="root.dir" value="/root">
		<isset property="unix" />
	</condition>
	
    <!--Location Of Tomcat-Server -->
	<property name="tomcat.dir" value="/apache-tomcat-8.0.36" />
	
	<target name="deploy-vms">
		<copy todir="${root.dir}/${tomcat.dir}/webapps/vms" includeEmptyDirs="no">
			<fileset dir="vms/target/vms">
				<patternset>
					<include name="**/*.*"/>
				</patternset>
			</fileset>
		</copy>
	</target>

</project>