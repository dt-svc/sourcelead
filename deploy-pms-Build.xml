<project name="deploy-ats" basedir="../" default="deploy-ats">
   <condition property="unix">
		<os family="unix" />
	</condition>

	<condition property="windows">
		<os family="windows" />
	</condition>

	<condition property="root.dir" value="c:">
		<isset property="windows" />
	</condition>
	<condition property="root.dir" value="/root">
		<isset property="unix" />
	</condition>
	
    <!--Location Of Tomcat-Server -->
	<property name="tomcat.dir" value="/apache-tomcat-8.0.36" />
	
	<target name="deploy-ats">
		<copy todir="${root.dir}/${tomcat.dir}/webapps/ats" includeEmptyDirs="no">
			<fileset dir="ats/target/ats">
				<patternset>
					<include name="**/*.*"/>
				</patternset>
			</fileset>
		</copy>
	</target>

</project>