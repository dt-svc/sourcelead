.75pt #000000;"></div><div class="awdiv" style="left:0.25pt; top:424.97pt; width:478.3pt; height:0pt; border-top:solid 0.75pt #000000;"></div><div class="awdiv" style="left:0.25pt; top:453.07pt; width:478.3pt; height:0pt; border-top:solid 0.75pt #000000;"></div><div class="awdiv" style="left:0.25pt; top:522.56pt; width:478.3pt; height:0pt; border-top:solid 0.75pt #000000;"></div><div class="awdiv" style="left:0.25pt; top:592.06pt; width:478.3pt; height:0pt; border-top:solid 0.75pt #000000;"></div><div class="awdiv" style="left:-0.25pt; top:633.95pt; width:479.3pt; height:0pt; border-top:solid 0.75pt #000000;"></div></div></div></div><div class="awdiv awpage" style="width:612pt; height:792pt;"><div class="awdiv" style="left:72pt; top:36pt; clip:rect(0pt,540pt,26.3pt,-72pt);"><span class="awspan awtext002" style="font-size:10pt; left:341.86pt; top:14.13pt; line-height:11.17pt;">Sourcelead – Jobs Module</span></div><div class="awdiv" style="left:72pt; top:742pt; clip:rect(0pt,540pt,15pt,-72pt);"><span class="awspan awtext002" style="font-size:10pt; left:0pt; top:2.83pt; line-height:11.17pt;">Quick Reference Guide</span><span class="awspan awtext002" style="font-size:10pt; left:462.44pt; top:2.83pt; line-height:11.17pt;">8</span><div class="awdiv" style="left:-1.45pt; top:0pt; width:470.9pt; height:0pt; border-top:solid 1.5pt #000000;"></div></div><div class="awdiv" style="left:72pt; top:72pt;"><div class="awdiv" style="left:-5.4pt;"><div class="awdiv" style="left:239.4pt; clip:rect(0.5pt,239.15pt,15.3pt,0.25pt);"><div class="awdiv" style="left:5.4pt; top:0.5pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">formats only. </span></div></div><div class="awdiv" style="top:14.3pt;"><div class="awdiv" style="clip:rect(0.5pt,239.15pt,42.9pt,0.25pt);"><div class="awdiv" style="left:5.4pt; top:0.5pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">Description</span></div></div><div class="awdiv" style="left:239.4pt; clip:rect(0.5pt,239.15pt,42.9pt,0.25pt);"><div class="awdiv" style="left:5.4pt; top:0.5pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">It represents the Text area which allows </span><span class="awspan awtext003" style="left:0pt; top:14.19pt; line-height:13.41pt;">filling the essential data regarding the Job. </span><span class="awspan awtext003" style="left:0pt; top:27.99pt; line-height:13.41pt;">It’s a text field with various flexible options.</span></div></div></div><div class="awdiv" style="top:56.2pt;"><div class="awdiv" style="clip:rect(0.5pt,239.15pt,56.7pt,0.25pt);"><div class="awdiv" style="left:5.4pt; top:0.5pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">Notice period</span><span class="awspan awtext003" style="left:70.71pt; top:0.39pt; line-height:13.41pt;">  </span></div></div><div class="awdiv" style="left:239.4pt; clip:rect(0.5pt,239.15pt,56.7pt,0.25pt);"><div class="awdiv" style="left:5.4pt; top:0.5pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">It represents the relieving Time period of </span><span class="awspan awtext003" style="left:0pt; top:14.19pt; line-height:13.41pt;">an applicant required for a Job. It’s a </span><span class="awspan awtext003" style="left:0pt; top:27.99pt; line-height:13.41pt;">dropdown field with Notice period </span><span class="awspan awtext003" style="left:0pt; top:41.79pt; line-height:13.41pt;">durations (15 days, 1 month---).</span><span class="awspan awtext003" style="left:168.07pt; top:41.79pt; line-height:13.41pt;"> </span></div></div></div><div class="awdiv" style="top:111.89pt;"><div class="awdiv" style="clip:rect(0.5pt,239.15pt,111.89pt,0.25pt);"><div class="awdiv" style="left:5.4pt; top:0.5pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">Cooling off period</span></div></div><div class="awdiv" style="left:239.4pt; clip:rect(0.5pt,239.15pt,111.89pt,0.25pt);"><div class="awdiv" style="left:5.4pt; top:0.5pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">It represents one of the applicant filtering </span><span class="awspan awtext003" style="left:0pt; top:14.19pt; line-height:13.41pt;">methods in Hiring process. It’s a dropdown </span><span class="awspan awtext003" style="left:0pt; top:27.99pt; line-height:13.41pt;">field. It shows the list of Time</span><span class="awspan awtext003" style="left:154.06pt; top:27.99pt; line-height:13.41pt;">           </span><span class="awspan awtext003" style="left:0pt; top:41.79pt; line-height:13.41pt;">periods to select the required for the Job. It </span><span class="awspan awtext003" style="left:0pt; top:55.59pt; line-height:13.41pt;">is configured in Org settings.(3 months, 5 </span><span class="awspan awtext003" style="left:0pt; top:69.39pt; line-height:13.41pt;">months---). Based on the given cooling off </span><span class="awspan awtext003" style="left:0pt; top:83.19pt; line-height:13.41pt;">period applicant should be moved to </span><span class="awspan awtext003" style="left:0pt; top:96.99pt; line-height:13.41pt;">rejected stage.</span><span class="awspan awtext003" style="left:78.71pt; top:96.99pt; line-height:13.41pt;"> </span></div></div></div><div class="awdiv" style="left:-0.25pt; top:0.5pt; width:0pt; height:222.28pt; border-left:solid 0.75pt #000000;"></div><div class="awdiv" style="left:239.15pt; top:0.5pt; width:0pt; height:13.8pt; border-left:solid 0.75pt #000000;"></div><div class="awdiv" style="left:239.15pt; top:14.8pt; width:0pt; height:41.4pt; border-left:solid 0.75pt #000000;"></div><div class="awdiv" style="left:239.15pt; top:56.7pt; width:0pt; height:55.2pt; border-left:solid 0.75pt #000000;"></div><div class="awdiv" style="left:239.15pt; top:112.39pt; width:0pt; height:110.39pt; border-left:solid 0.75pt #000000;"></div><div class="awdiv" style="left:478.55pt; top:0.5pt; width:0pt; height:222.28pt; border-left:solid 0.75pt #000000;"></div><div class="awdiv" style="left:-0.25pt; top:0pt; width:479.3pt; height:0pt; border-top:solid 0.75pt #000000;"></div><div class="awdiv" style="left:0.25pt; top:14.3pt; width:478.3pt; height:0pt; border-top:solid 0.75pt #000000;"></div><div class="awdiv" style="left:0.25pt; top:56.2pt; width:478.3pt; height:0pt; border-top:solid 0.75pt #000000;"></div><div class="awdiv" style="left:0.25pt; top:111.89pt; width:478.3pt; height:0pt; border-top:solid 0.75pt #000000;"></div><div class="awdiv" style="left:-0.25pt; top:222.78pt; width:479.3pt; height:0pt; border-top:solid 0.75pt #000000;"></div></div><div class="awdiv" style="top:237.08pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">Under Client Job, you need to fill in the following fields:</span></div><div class="awdiv" style="left:-5.4pt; top:250.88pt;"><div class="awdiv" style="clip:rect(0.5pt,239.15pt,15.3pt,0.25pt);"><div class="awdiv" style="left:5.4pt; top:0.5pt;"><span class="awspan awtext002" style="left:0pt; top:0.39pt; line-height:13.41pt;">Elements</span></div></div><div class="awdiv" style="left:239.4pt; clip:rect(0.5pt,239.15pt,15.3pt,0.25pt);"><div class="awdiv" style="left:5.4pt; top:0.5pt;"><span class="awspan awtext002" style="left:0pt; top:0.39pt; line-height:13.41pt;">Description</span></div></div><div class="awdiv" style="top:14.3pt;"><div class="awdiv" style="clip:rect(0.5pt,239.15pt,56.7pt,0.25pt);"><div class="awdiv" style="left:5.4pt; top:0.5pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">Client</span></div></div><div class="awdiv" style="left:239.4pt; clip:rect(0.5pt,239.15pt,56.7pt,0.25pt);"><div class="awdiv" style="left:5.4pt; top:0.5pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">The dropdown shows the list of Clients in </span><span class="awspan awtext003" style="left:0pt; top:14.19pt; line-height:13.41pt;">our Organization. Here, we can select the </span><span class="awspan awtext003" style="left:0pt; top:27.99pt; line-height:13.41pt;">Client required. It’s a dropdown and a </span><span class="awspan awtext003" style="left:0pt; top:41.79pt; line-height:13.41pt;">mandatory field. </span></div></div></div><div class="awdiv" style="top:70pt;"><div class="awdiv" style="clip:rect(0.5pt,239.15pt,15.3pt,0.25pt);"><div class="awdiv" style="left:5.4pt; top:0.5pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">‘ + ‘</span><span class="awspan awtext003" style="left:19.01pt; top:0.39pt; line-height:13.41pt;">  </span><span class="awspan awtext003" style="left:25.68pt; top:0.39pt; line-height:13.41pt;">for Client</span></div></div><div class="awdiv" style="left:239.4pt; clip:rect(0.5pt,239.15pt,15.3pt,0.25pt);"><div class="awdiv" style="left:5.4pt; top:0.5pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">It’s a shortcut for adding new client </span></div></div></div><div class="awdiv" style="top:84.29pt;"><div class="awdiv" style="clip:rect(0.5pt,239.15pt,70.5pt,0.25pt);"><div class="awdiv" style="left:5.4pt; top:0.5pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">Client contact</span></div></div><div class="awdiv" style="left:239.4pt; clip:rect(0.5pt,239.15pt,70.5pt,0.25pt);"><div class="awdiv" style="left:5.4pt; top:0.5pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">The dropdown shows the list of Client </span><span class="awspan awtext003" style="left:0pt; top:14.19pt; line-height:13.41pt;">contacts with respect to the opted Client. </span><span class="awspan awtext003" style="left:0pt; top:27.99pt; line-height:13.41pt;">Here, we can select the ‘Client contact’ </span><span class="awspan awtext003" style="left:0pt; top:41.79pt; line-height:13.41pt;">required. It’s a dropdown and a mandatory </span><span class="awspan awtext003" style="left:0pt; top:55.59pt; line-height:13.41pt;">field</span></div></div></div><div class="awdiv" style="top:153.79pt;"><div class="awdiv" style="clip:rect(0.5pt,239.15pt,29.1pt,0.25pt);"><div class="awdiv" style="left:5.4pt; top:0.5pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">‘ + ‘ for Client contact</span></div></div><div class="awdiv" style="left:239.4pt; clip:rect(0.5pt,239.15pt,29.1pt,0.25pt);"><div class="awdiv" style="left:5.4pt; top:0.5pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">It’s a shortcut for adding the new client </span><span class="awspan awtext003" style="left:0pt; top:14.19pt; line-height:13.41pt;">contact</span></div></div></div><div class="awdiv" style="top:181.89pt;"><div class="awdiv" style="clip:rect(0.5pt,239.15pt,70.5pt,0.25pt);"><div class="awdiv" style="left:5.4pt; top:0.5pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">Bill rate/ Salary</span></div></div><div class="awdiv" style="left:239.4pt; clip:rect(0.5pt,239.15pt,70.5pt,0.25pt);"><div class="awdiv" style="left:5.4pt; top:0.5pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">It represents the client deal/rate for the </span><span class="awspan awtext003" style="left:0pt; top:14.19pt; line-height:13.41pt;">applicants for the Job. The field consists of </span><span class="awspan awtext003" style="left:0pt; top:27.99pt; line-height:13.41pt;">‘Rate type’ and ‘Rate per’ sub fields. We </span><span class="awspan awtext003" style="left:0pt; top:41.79pt; line-height:13.41pt;">can enter the required rate value along </span><span class="awspan awtext003" style="left:0pt; top:55.59pt; line-height:13.41pt;">with ‘Rate per’ and ‘Rate type</span></div></div></div><div class="awdiv" style="top:251.38pt;"><div class="awdiv" style="clip:rect(0.5pt,239.15pt,42.9pt,0.25pt);"><div class="awdiv" style="left:5.4pt; top:0.5pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">Rate type</span></div></div><div class="awdiv" style="left:239.4pt; clip:rect(0.5pt,239.15pt,42.9pt,0.25pt);"><div class="awdiv" style="left:5.4pt; top:0.5pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">It is sub divided into Min rate and Max </span><span class="awspan awtext003" style="left:0pt; top:14.19pt; line-height:13.41pt;">rate. It represents the Rate to be paid/ </span><span class="awspan awtext003" style="left:0pt; top:27.99pt; line-height:13.41pt;">applicable for the job. (8L-10L Yearly) </span></div></div></div><div class="awdiv" style="top:293.28pt;"><div class="awdiv" style="clip:rect(0.5pt,239.15pt,42.9pt,0.25pt);"><div class="awdiv" style="left:5.4pt; top:0.5pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">Submission form</span></div></div><div class="awdiv" style="left:239.4pt; clip:rect(0.5pt,239.15pt,42.9pt,0.25pt);"><div class="awdiv" style="left:5.4pt; top:0.5pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">It is by default pre-defined Template of a </span><span class="awspan awtext003" style="left:0pt; top:14.19pt; line-height:13.41pt;">Client .If required Client can select </span><span class="awspan awtext003" style="left:0pt; top:27.99pt; line-height:13.41pt;">templates which are in the dropdown list</span></div></div></div><div class="awdiv" style="left:-0.25pt; top:0.5pt; width:0pt; height:334.68pt; border-left:solid 0.75pt #000000;"></div><div class="awdiv" style="left:239.15pt; top:0.5pt; width:0pt; height:13.8pt; border-left:solid 0.75pt #000000;"></div><div class="awdiv" style="left:239.15pt; top:14.8pt; width:0pt; height:55.2pt; border-left:solid 0.75pt #000000;"></div><div class="awdiv" style="left:239.15pt; top:70.5pt; width:0pt; height:13.8pt; border-left:solid 0.75pt #000000;"></div><div class="awdiv" style="left:239.15pt; top:84.79pt; width:0pt; height:69pt; border-left:solid 0.75pt #000000;"></div><div class="awdiv" style="left:239.15pt; top:154.29pt; width:0pt; height:27.6pt; border-left:solid 0.75pt #000000;"></div><div class="awdiv" style="left:239.15pt; top:182.39pt; width:0pt; height:69pt; border-left:solid 0.75pt #000000;"></div><div class="awdiv" style="left:239.15pt; top:251.88pt; width:0pt; height:41.4pt; border-left:solid 0.75pt #000000;"></div><div class="awdiv" style="left:239.15pt; top:293.78pt; width:0pt; height:41.4pt; border-left:solid 0.75pt #000000;"></div><div class="awdiv" style="left:478.55pt; top:0.5pt; width:0pt; height:334.68pt; border-left:solid 0.75pt #000000;"></div><div class="awdiv" style="left:-0.25pt; top:0pt; width:479.3pt; height:0pt; border-top:solid 0.75pt #000000;"></div><div class="awdiv" style="left:0.25pt; top:14.3pt; width:478.3pt; height:0pt; border-top:solid 0.75pt #000000;"></div><div class="awdiv" style="left:0.25pt; top:70pt; width:478.3pt; height:0pt; border-top:solid 0.75pt #000000;"></div><div class="awdiv" style="left:0.25pt; top:84.29pt; width:478.3pt; height:0pt; border-top:solid 0.75pt #000000;"></div><div class="awdiv" style="left:0.25pt; top:153.79pt; width:478.3pt; height:0pt; border-top:solid 0.75pt #000000;"></div><div class="awdiv" style="left:0.25pt; top:181.89pt; width:478.3pt; height:0pt; border-top:solid 0.75pt #000000;"></div><div class="awdiv" style="left:0.25pt; top:251.38pt; width:478.3pt; height:0pt; border-top:solid 0.75pt #000000;"></div><div class="awdiv" style="left:0.25pt; top:293.28pt; width:478.3pt; height:0pt; border-top:solid 0.75pt #000000;"></div><div class="awdiv" style="left:-0.25pt; top:335.18pt; width:479.3pt; height:0pt; border-top:solid 0.75pt #000000;"></div></div><div class="awdiv" style="top:600.36pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">Internal Details to be filled are as follows:</span></div><div class="awdiv" style="left:-5.4pt; top:614.16pt;"><div class="awdiv" style="clip:rect(0.5pt,239.15pt,15.3pt,0.25pt);"><div class="awdiv" style="left:5.4pt; top:0.5pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">Elements</span></div></div><div class="awdiv" style="left:239.4pt; clip:rect(0.5pt,239.15pt,15.3pt,0.25pt);"><div class="awdiv" style="left:5.4pt; top:0.5pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">Description</span></div></div><div class="awdiv" style="top:14.3pt;"><div class="awdiv" style="clip:rect(0.5pt,239.15pt,15.3pt,0.25pt);"><div class="awdiv" style="left:5.4pt; top:0.5pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">Manager</span></div></div><div class="awdiv" style="left:239.4pt; clip:rect(0.5pt,239.15pt,15.3pt,0.25pt);"><div class="awdiv" style="left:5.4pt; top:0.5pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">By default, name of the Admin populates, </span></div></div></div><div class="awdiv" style="left:-0.25pt; top:0.5pt; width:0pt; height:28.1pt; border-left:solid 0.75pt #000000;"></div><div class="awdiv" style="left:239.15pt; top:0.5pt; width:0pt; height:13.8pt; border-left:solid 0.75pt #000000;"></div><div class="awdiv" style="left:239.15pt; top:14.8pt; width:0pt; height:13.8pt; border-left:solid 0.75pt #000000;"></div><div class="awdiv" style="left:478.55pt; top:0.5pt; width:0pt; height:28.1pt; border-left:solid 0.75pt #000000;"></div><div class="awdiv" style="left:-0.25pt; top:0pt; width:479.3pt; height:0pt; border-top:solid 0.75pt #000000;"></div><div class="awdiv" style="left:0.25pt; top:14.3pt; width:478.3pt; height:0pt; border-top:solid 0.75pt #000000;"></div><div class="awdiv" style="left:-0.25pt; top:28.6pt; width:479.3pt; height:0pt; border-top:solid 0.75pt #000000;"></div></div></div></div><div class="awdiv awpage" style="width:612pt; height:792pt;"><div class="awdiv" style="left:72pt; top:36pt; clip:rect(0pt,540pt,26.3pt,-72pt);"><span class="awspan awtext002" style="font-size:10pt; left:341.86pt; top:14.13pt; line-height:11.17pt;">Sourcelead – Jobs Module</span></div><div class="awdiv" style="left:72pt; top:742pt; clip:rect(0pt,540pt,15pt,-72pt);"><span class="awspan awtext002" style="font-size:10pt; left:0pt; top:2.83pt; line-height:11.17pt;">Quick Reference Guide</span><span class="awspan awtext002" style="font-size:10pt; left:462.44pt; top:2.83pt; line-height:11.17pt;">9</span><div class="awdiv" style="left:-1.45pt; top:0pt; width:470.9pt; height:0pt; border-top:solid 1.5pt #000000;"></div></div><div class="awdiv" style="left:72pt; top:72pt;"><div class="awdiv" style="left:-5.4pt;"><div class="awdiv" style="left:239.4pt; clip:rect(0.5pt,239.15pt,29.1pt,0.25pt);"><div class="awdiv" style="left:5.4pt; top:0.5pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">If required we can select from the </span><span class="awspan awtext003" style="left:0pt; top:14.19pt; line-height:13.41pt;">dropdown. It is a mandatory field</span></div></div><div class="awdiv" style="top:28.1pt;"><div class="awdiv" style="clip:rect(0.5pt,239.15pt,42.9pt,0.25pt);"><div class="awdiv" style="left:5.4pt; top:0.5pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">Assigned to</span></div></div><div class="awdiv" style="left:239.4pt; clip:rect(0.5pt,239.15pt,42.9pt,0.25pt);"><div class="awdiv" style="left:5.4pt; top:0.5pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">We can assign the Job to other users also </span><span class="awspan awtext003" style="left:0pt; top:14.19pt; line-height:13.41pt;">if required in the org. It is not a mandatory </span><span class="awspan awtext003" style="left:0pt; top:27.99pt; line-height:13.41pt;">field.</span></div></div></div><div class="awdiv" style="top:70pt;"><div class="awdiv" style="clip:rect(0.5pt,239.15pt,42.9pt,0.25pt);"><div class="awdiv" style="left:5.4pt; top:0.5pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">Application Form</span></div></div><div class="awdiv" style="left:239.4pt; clip:rect(0.5pt,239.15pt,42.9pt,0.25pt);"><div class="awdiv" style="left:5.4pt; top:0.5pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">It is by default pre-defined Template of an </span><span class="awspan awtext003" style="left:0pt; top:14.19pt; line-height:13.41pt;">org. If required user can select a templates </span><span class="awspan awtext003" style="left:0pt; top:27.99pt; line-height:13.41pt;">from the dropdown list.</span></div></div></div><div class="awdiv" style="top:111.89pt;"><div class="awdiv" style="clip:rect(0.5pt,239.15pt,15.3pt,0.25pt);"><div class="awdiv" style="left:5.4pt; top:0.5pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">Add Team</span></div></div><div class="awdiv" style="left:239.4pt; clip:rect(0.5pt,239.15pt,15.3pt,0.25pt);"><div class="awdiv" style="left:5.4pt; top:0.5pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">It’s a shortcut for adding the new team.</span></div></div></div><div class="awdiv" style="top:126.19pt;"><div class="awdiv" style="clip:rect(0.5pt,239.15pt,56.7pt,0.25pt);"><div class="awdiv" style="left:5.4pt; top:0.5pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">Priority</span></div></div><div class="awdiv" style="left:239.4pt; clip:rect(0.5pt,239.15pt,56.7pt,0.25pt);"><div class="awdiv" style="left:5.4pt; top:0.5pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">By default, the priority of the Job will be </span><span class="awspan awtext003" style="left:0pt; top:14.19pt; line-height:13.41pt;">‘Medium’. If required we can select other </span><span class="awspan awtext003" style="left:0pt; top:27.99pt; line-height:13.41pt;">priorities from the dropdown. It is a </span><span class="awspan awtext003" style="left:0pt; top:41.79pt; line-height:13.41pt;">mandatory field.</span></div></div></div><div class="awdiv" style="left:-0.25pt; top:0.5pt; width:0pt; height:181.39pt; border-left:solid 0.75pt #000000;"></div><div class="awdiv" style="left:239.15pt; top:0.5pt; width:0pt; height:27.6pt; border-left:solid 0.75pt #000000;"></div><div class="awdiv" style="left:239.15pt; top:28.6pt; width:0pt; height:41.4pt; border-left:solid 0.75pt #000000;"></div><div class="awdiv" style="left:239.15pt; top:70.5pt; width:0pt; height:41.4pt; border-left:solid 0.75pt #000000;"></div><div class="awdiv" style="left:239.15pt; top:112.39pt; width:0pt; height:13.8pt; border-left:solid 0.75pt #000000;"></div><div class="awdiv" style="left:239.15pt; top:126.69pt; width:0pt; height:55.2pt; border-left:solid 0.75pt #000000;"></div><div class="awdiv" style="left:478.55pt; top:0.5pt; width:0pt; height:181.39pt; border-left:solid 0.75pt #000000;"></div><div class="awdiv" style="left:-0.25pt; top:0pt; width:479.3pt; height:0pt; border-top:solid 0.75pt #000000;"></div><div class="awdiv" style="left:0.25pt; top:28.1pt; width:478.3pt; height:0pt; border-top:solid 0.75pt #000000;"></div><div class="awdiv" style="left:0.25pt; top:70pt; width:478.3pt; height:0pt; border-top:solid 0.75pt #000000;"></div><div class="awdiv" style="left:0.25pt; top:111.89pt; width:478.3pt; height:0pt; border-top:solid 0.75pt #000000;"></div><div class="awdiv" style="left:0.25pt; top:126.19pt; width:478.3pt; height:0pt; border-top:solid 0.75pt #000000;"></div><div class="awdiv" style="left:-0.25pt; top:181.89pt; width:479.3pt; height:0pt; border-top:solid 0.75pt #000000;"></div></div><div class="awdiv" style="top:196.19pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">Select </span><span class="awspan awtext002" style="left:36.69pt; top:0.39pt; line-height:13.41pt;">Approver required</span><span class="awspan awtext003" style="left:141.38pt; top:0.39pt; line-height:13.41pt;"> and the Approval mechanism will be enabled.</span><span class="awspan awtext003" style="left:386.19pt; top:0.39pt; line-height:13.41pt;"> </span><span class="awspan awtext003" style="left:389.52pt; top:0.39pt; line-height:13.41pt;">There are two </span><span class="awspan awtext003" style="left:0pt; top:14.19pt; line-height:13.41pt;">types of approval mechanisms:</span></div><div class="awdiv" style="top:223.78pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;"> 1. Parallel Approval Mechanism</span></div><div class="awdiv" style="top:237.58pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;"> 2. Sequential Approval Mechanism</span></div><div class="awdiv" style="top:265.18pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">1. Parallel Mechanism</span></div><div class="awdiv" style="left:36pt; top:278.98pt;"><span class="awspan awtext005" style="left:0pt; top:1.66pt; line-height:12pt;"></span><span class="awspan awtext003" style="left:18pt; top:0.39pt; line-height:13.41pt;">Here, the process is done by the parallel approvers. </span></div><div class="awdiv" style="left:36pt; top:292.78pt;"><span class="awspan awtext005" style="left:0pt; top:1.66pt; line-height:12pt;"></span><span class="awspan awtext003" style="left:18pt; top:0.39pt; line-height:13.41pt;">If any of the assigned approver accepts the Job request, then status of the </span><span class="awspan awtext003" style="left:18pt; top:14.19pt; line-height:13.41pt;">Job would be ‘OPEN’. </span></div><div class="awdiv" style="left:36pt; top:320.38pt;"><span class="awspan awtext005" style="left:0pt; top:1.66pt; line-height:12pt;"></span><span class="awspan awtext003" style="left:18pt; top:0.39pt; line-height:13.41pt;">If none of the assigned approvers in the parallel mechanism accepts the </span><span class="awspan awtext003" style="left:18pt; top:14.19pt; line-height:13.41pt;">request then the Job status will be in ‘SUBMITTED’ stage only. </span></div><div class="awdiv" style="left:36pt; top:347.98pt;"><span class="awspan awtext005" style="left:0pt; top:1.66pt; line-height:12pt;"></span><span class="awspan awtext003" style="left:18pt; top:0.39pt; line-height:13.41pt;">If any of the approvers rejects the Job then, the status would be ‘REJECTED’</span><span class="awspan awtext003" style="left:427.54pt; top:0.39pt; line-height:13.41pt;"> </span></div><div class="awdiv" style="top:361.77pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">2. </span><span class="awspan awtext003" style="left:13.34pt; top:0.39pt; line-height:13.41pt;">Sequential Mechanism</span></div><div class="awdiv" style="left:36pt; top:375.57pt;"><span class="awspan awtext005" style="left:0pt; top:1.66pt; line-height:12pt;"></span><span class="awspan awtext003" style="left:18pt; top:0.39pt; line-height:13.41pt;">Sequential mechanism is managed by two Levels of approvers</span><span class="awspan awtext003" style="left:350.85pt; top:0.39pt; line-height:13.41pt;"> </span></div><div class="awdiv" style="left:54pt; top:389.37pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">-</span><span class="awspan awtext003" style="left:18pt; top:0.39pt; line-height:13.41pt;">Level-1</span><span class="awspan awtext003" style="left:57.36pt; top:0.39pt; line-height:13.41pt;"> </span></div><div class="awdiv" style="left:54pt; top:403.17pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">-</span><span class="awspan awtext003" style="left:18pt; top:0.39pt; line-height:13.41pt;">Level-2</span><span class="awspan awtext003" style="left:57.36pt; top:0.39pt; line-height:13.41pt;"> </span></div><div class="awdiv" style="left:36pt; top:416.97pt;"><span class="awspan awtext005" style="left:0pt; top:1.66pt; line-height:12pt;"></span><span class="awspan awtext003" style="left:18pt; top:0.39pt; line-height:13.41pt;">When Level-1 Approver approves the job request, then it will be forwarded to </span><span class="awspan awtext003" style="left:18pt; top:14.19pt; line-height:13.41pt;">Level-2 Approver. </span></div><div class="awdiv" style="left:36pt; top:444.57pt;"><span class="awspan awtext005" style="left:0pt; top:1.66pt; line-height:12pt;"></span><span class="awspan awtext003" style="left:18pt; top:0.39pt; line-height:13.41pt;">If Level-2 approver approves the Job request then the Job will be in ‘OPEN’ </span><span class="awspan awtext003" style="left:18pt; top:14.19pt; line-height:13.41pt;">status. </span></div><div class="awdiv" style="left:36pt; top:472.17pt;"><span class="awspan awtext005" style="left:0pt; top:1.66pt; line-height:12pt;"></span><span class="awspan awtext003" style="left:18pt; top:0.39pt; line-height:13.41pt;">If Level-1 Approver rejects the Job it will turn ‘REJECTED’ state and not </span><span class="awspan awtext003" style="left:18pt; top:14.19pt; line-height:13.41pt;">forward to Level-2 approver.</span><span class="awspan awtext003" style="left:168.08pt; top:14.19pt; line-height:13.41pt;"> </span></div><div class="awdiv" style="top:499.76pt;"><span class="awspan awtext003" style="left:0pt; top:0.39pt; line-height:13.41pt;">    </span></div></div></div><div class="awdiv awpage" style="width:612pt; height:792pt;"><div class="awdiv" style="left:72pt; top:36pt; clip:rect(0pt,540pt,26.3pt,-72pt);"><span class="awspan awtext002" style="font-size:10pt; left:341.86pt; top:14.13pt; line-height:11.17pt;">Sourcelead – Jobs Module</span></div><div class="awdiv" style="left:72pt; top:742pt; clip:rect(0pt,540pt,15pt,-72pt);"><span class="awspan awtext002" style="font-size:10pt; left:0pt; top:2.83pt; line-height:11.17pt;">Quick Reference Guide</span><span class="awspan awtext002" style="font-size:10pt; left:456.88pt; top:2.83pt; line-height:11.17pt;">10</span><div class="awdiv" style="left:-1.45pt; top:0pt; width:470.9pt; height:0pt; border-top:solid 1.5pt #000000;"></div></div><div class="awdiv" style="left:72pt; top:72pt;"><div class="awdiv" style="to