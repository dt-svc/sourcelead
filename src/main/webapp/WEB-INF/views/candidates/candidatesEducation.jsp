					 result = result+"			 </div>";
					 result = result+"		</div>"; 
					 result = result+"	</div>"; 
					 result = result+"  </div> "; 
					$("#candidateEducationList").empty();
				    $("#candidateEducationList").append(result); 
               }
        },
          
     }); 
}
