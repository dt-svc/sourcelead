		<form id="Candidate_Passport_form" name="Candidate_Passport_form" method="post"> 
		<div class="popUpOut" id="popPassView">
		<input type="hidden" value="${immigrationId}"  id="immigrationId" >
	     <input type="hidden" value="${candidateId}"  id="candidateId" >
		<div class="popupHead">
			<h2>Add Passport</h2><a href="javascript:void(0)" class="fa fa-close popCan"></a>
		</div>
		
		<div class="popupMid clearfix">
        
          <div class="col-sm-12 noPad mt clearfix">
				<label class="col-md-4 padding_left">Passport Id<span class="text-danger">&nbsp;*</span></label>
              	<div class="col-md-8 padding_right">
              		<input type="text" name = "idNumber" id = "idNumber" field-name = "Passport Id" class="form-control" data-validation = "required"/>
				</div>
			</div>				          
          <div class="col-sm-12 noPad mt clearfix">
				<label class="col-md-4 padding_left">Country</label>
              	<div class="col-md-8 padding_right">
					<select class="chosen-select form-control">
					  <option>Select Country</option>
					  <option>India</option>
					  <option>USA</option>
					  <option>UK</option>
					</select>
				</div>
			</div>
          <div class="col-sm-12 noPad mt clearfix">
				<label class="col-md-4 padding_left">Valid From</label>
              	<div class="col-md-8 padding_right">
              		<input type="text" class="form-control calendar" value="" name = "validFrom" id = "validFrom" field-name = "Valid From"/>
				    <div class="clearDate" onClick="clearCandidateCertStartDate();"></div>
				</div>
			</div>
          <div class="col-sm-12 noPad mt clearfix">
				<label class="col-md-4 padding_left">Valid To</label>
              	<div class="col-md-8 padding_right">
              		<input type="text" class="form-control calendar" value="" name = "validTo" id = "validTo" field-name = "Valid To" />
				<div class="clearDate" onClick="clearCandidateCertEndDate();"></div>
				</div>
			</div>									
		</div>
		
		
		<div class="immiPopFoot">
            <input value="Save" class="" type="button" id="passport_save_id" onclick="savePassportDetails('save')">
            <input value="Cancel" class="popCan" type="button">
          </div>		
	</div><!--popcode end  -->
		</form>
		<script>
		 var locationDate ='${SourceLeadWeb_orgLocations.dateFormat}'; 
		  var finalDateFormatCerSave = getJSDateFormat(locationDate);
		  
		 $('#validFrom').datepicker({
		      dateFormat: finalDateFormatCerSave,
		      changeMonth: true,
		  	  changeYear: true, 
		      onSelect: function (selected) {
		           // var dt = new Date(selected);
		           var dt = 	  $(this).datepicker('getDate', '+1d'); 
		           dt.setDate(dt.getDate() + 1);
		            $("#validTo").datepicker("option", "minDate", dt);
		        }
		  });
		  
		  $('#validTo').datepicker({
		      dateFormat: finalDateFormatCerSave,
		      changeMonth: true,
		  	  changeYear: true, 
		        onSelect: function (selected) {
		            //var dt = new Date(selected);
		            var dt = 	  $(this).datepicker('getDate', '-1d');
		            dt.setDate(dt.getDate() - 1);
		            $("#validFrom").datepicker("option", "maxDate", dt);
		        }
		  });
		</script>
		<script>
		<script>
		function clearCandidateCertStartDate(){
			$("#validFrom").val("");
			};
		function clearCandidateCertEndDate(){
			$("#validTo").val("");
			};
		</script>   
<script>
function toDate(selector) {
    var from = $(selector).val().split("-");
    return new Date(from[2], from[1] - 1, from[0]);
}
</script>
		
