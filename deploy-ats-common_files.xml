<project name="deploy-ats" basedir="../" default="deploy-ats">
   <condition property="unix">
		<os family="unix" />
	</condition>

	<condition property="windows">
		<os family="windows" />
	</condition>

	<condition property="root.dir" value="c:">
		<isset property="windows" />
	</condition>
	<condition property="root.dir" value="/root">
		<isset property="unix" />
	</condition>
	
    <!--Location Of Tomcat-Server -->
	<property name="tomcat.dir" value="\tomcat" />

	<target name="deploy-ats">
		<copy todir="${root.dir}/${tomcat.dir}/wtpwebapps/ats/WEB-INF/views" includeEmptyDirs="no">
			<fileset dir="ats/target/ats/WEB-INF/views">
				<patternset>
					<include name="**/*.jsp"/>
				</patternset>
			</fileset>
		</copy>
		<copy todir="${root.dir}/${tomcat.dir}/wtpwebapps/ats/resources/css" includeEmptyDirs="no">
			<fileset dir="ats/target/ats/resources/css">
				<patternset>
					<include name="**/*.css"/>
				</patternset>
			</fileset>
		</copy>
		<copy todir="${root.dir}/${tomcat.dir}/wtpwebapps/ats/resources/js" includeEmptyDirs="no">
			<fileset dir="ats/target/ats/resources/js">
				<patternset>
					<include name="**/*.js"/>
				</patternset>
			</fileset>
		</copy>
		
		<copy todir="${root.dir}/${tomcat.dir}/wtpwebapps/ats/resources/images" includeEmptyDirs="no">
			      <fileset dir="ats/target/ats/resources/images">
						<patternset>
							<include name="**/*.jpg"/>
							<include name="**/*.png"/>
							<include name="**/*.jpeg"/>
							<include name="**/*.gif"/>
						</patternset>
					</fileset>
	    </copy>
        <copy todir="${root.dir}/${tomcat.dir}/wtpwebapps/ats/resources/fonts" includeEmptyDirs="no">
			      <fileset dir="ats/target/ats/resources/fonts">
						<patternset>
							<include name="**/*.otf"/>
							<include name="**/*.eot"/>
							<include name="**/*.svg"/>
							<include name="**/*.ttf"/>
							<include name="**/*.woff"/>
							<include name="**/*.woff2"/>
						</patternset>
					</fileset>
	    </copy>
	</target>

</project>