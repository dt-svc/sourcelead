<project name="sourcelead-jsp" basedir="../" default="delete-jar">
	 <condition property="unix">
			<os family="unix" />
		</condition>

		<condition property="windows">
			<os family="windows" />
		</condition>

		<condition property="root.dir" value="c:">
			<isset property="windows" />
		</condition>
		<condition property="root.dir" value="/root">
			<isset property="unix" />
		</condition>
	
    <!--Location Of Tomcat-Server -->
	<property name="tomcat.dir" value="/apache-tomcat-9.0.14" />

	<target name="delete-jar">
		        <delete>
		               <fileset dir="${root.dir}/${tomcat.dir}/wtpwebapps/admin/WEB-INF/lib" includes  = "poi-2.5.1-final-20040804.jar"/>
		               <fileset dir="${root.dir}/${tomcat.dir}/wtpwebapps/ats/WEB-INF/lib" includes  = "poi-2.5.1-final-20040804.jar"/>
		               <fileset dir="${root.dir}/${tomcat.dir}/wtpwebapps/pms/WEB-INF/lib" includes  = "poi-2.5.1-final-20040804.jar"/>
		               <fileset dir="${root.dir}/${tomcat.dir}/wtpwebapps/vms/WEB-INF/lib" includes  = "poi-2.5.1-final-20040804.jar"/>
		         </delete>
	</target>

</project>